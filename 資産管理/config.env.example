# GMO Coin API（残高照会専用の新規キー発行を推奨。発注権限を持つ既存キーの流用は非推奨）
GMO_API_KEY=
GMO_API_SECRET=

# Gmail通知（既存プロジェクトと同じアプリパスワードを使い回して構いません）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO_ADDRESS=

# Obsidian Vaultへの週次サマリー書き戻し先（未設定ならVault書き戻しはスキップされる）
OBSIDIAN_VAULT_PATH=C:\Obsidian Vault\Obsidian Vault

# スマホから残高入力・ダッシュボード閲覧をするためのOneDrive同期先（未設定ならローカルのみで運用）
ASSET_SYNC_DIR=C:\Users\<ユーザー名>\OneDrive\資産管理
